#!/bin/bash

NODE_BIN="/var/apps/nodejs_v22/target/bin/node"
SERVER_JS="${TRIM_APPDEST}/server/server.mjs"
DATA_DIR="${TRIM_PKGVAR}/data"
PORT="${TRIM_SERVICE_PORT:-38471}"
LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

fail_msg() {
  log_msg "$1"
  [ -n "${TRIM_TEMP_LOGFILE}" ] && echo "$1" > "${TRIM_TEMP_LOGFILE}"
}

process_alive() {
  kill -0 "$1" 2>/dev/null
}

read_pid() {
  [ -r "${PID_FILE}" ] || return 1
  head -n 1 "${PID_FILE}" | tr -d '[:space:]'
}

status_process() {
  local pid
  pid="$(read_pid)" || return 1
  if [ -n "${pid}" ] && process_alive "${pid}"; then
    return 0
  fi
  rm -f "${PID_FILE}"
  return 1
}

start_process() {
  if status_process; then
    return 0
  fi

  mkdir -p "${DATA_DIR}/videos" "${TRIM_PKGVAR}"
  if [ ! -x "${NODE_BIN}" ]; then
    fail_msg "未找到 Node.js 22。请在飞牛应用中心安装或更新 Node.js v22 后重试。"
    return 1
  fi

  NODE_FLAGS=""
  if ! "${NODE_BIN}" -e "require('node:sqlite')" >/dev/null 2>&1; then
    NODE_FLAGS="--experimental-sqlite"
    if ! "${NODE_BIN}" ${NODE_FLAGS} -e "require('node:sqlite')" >/dev/null 2>&1; then
      fail_msg "当前 Node.js 不支持内置 SQLite，请升级 Node.js v22。"
      return 1
    fi
  fi

  PUBLIC_BASE_URL=""
  if [ -r "${TRIM_PKGVAR}/public-url" ]; then
    PUBLIC_BASE_URL="$(head -n 1 "${TRIM_PKGVAR}/public-url")"
  fi

  log_msg "Starting async-loom native service on port ${PORT}"
  ASYNC_LOOM_DATA_DIR="${DATA_DIR}" \
    ASYNC_LOOM_PUBLIC_BASE_URL="${PUBLIC_BASE_URL}" \
    nohup "${NODE_BIN}" ${NODE_FLAGS} "${SERVER_JS}" --data "${DATA_DIR}" --port "${PORT}" --host 0.0.0.0 \
      >> "${LOG_FILE}" 2>&1 &
  printf "%s" "$!" > "${PID_FILE}"

  local count=0
  while [ "${count}" -lt 15 ]; do
    sleep 1
    if ! status_process; then
      fail_msg "异步录屏启动失败，请查看日志 ${LOG_FILE}"
      return 1
    fi
    if (exec 3<>/dev/tcp/127.0.0.1/${PORT}) 2>/dev/null; then
      log_msg "Started, pid=$(cat "${PID_FILE}")"
      return 0
    fi
    count=$((count + 1))
  done
  fail_msg "服务进程已启动，但端口 ${PORT} 未在 15 秒内就绪。"
  return 1
}

stop_process() {
  local pid
  pid="$(read_pid)" || return 0
  if [ -n "${pid}" ] && process_alive "${pid}"; then
    log_msg "Stopping pid ${pid}"
    kill -TERM "${pid}" 2>/dev/null
    local count=0
    while process_alive "${pid}" && [ "${count}" -lt 10 ]; do
      sleep 1
      count=$((count + 1))
    done
    process_alive "${pid}" && kill -KILL "${pid}" 2>/dev/null
  fi
  rm -f "${PID_FILE}"
  return 0
}

case "$1" in
start)
  start_process || exit 1
  ;;
stop)
  stop_process
  ;;
status)
  status_process && exit 0 || exit 3
  ;;
*)
  exit 1
  ;;
esac
exit 0
